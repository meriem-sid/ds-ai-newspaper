# Copy to .env and fill in. Never commit .env.

# ── Phase 1 ─────────────────────────────────────────────
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY= 
# Any Flash / Flash-Lite model id your key can access (check AI Studio's model list).
GEMINI_MODEL=gemini-3.8-flash

# Tried in order if the main model is overloaded (503) or out of quota.
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite

# Cross-provider fallback when every Gemini model is down. Free key: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b   # must support strict json_schema (gpt-oss-20b also works)
# GROQ_BATCH_SIZE=15                # free tier ~8K tokens/min

# Optional tuning
# LLM_TIMEOUT_SECONDS=120
# MIN_RELEVANCE=7
# LLM_BATCH_SIZE=40
# LLM_PAUSE_SECONDS=4

# ── Phase 2 ─────────────────────────────────────────────
# Neon → project → Connect → pooled connection string
DATABASE_URL=
# https://app.tavily.com (1,000 free credits/month; the pipeline uses ~8/day)
TAVILY_API_KEY=
# kaggle.com → Settings → API → Create New Token. A new-style "KGAT_..." token works on
# its own (Bearer auth); a legacy kaggle.json key also needs KAGGLE_USERNAME.
KAGGLE_KEY=
KAGGLE_USERNAME=

# ── Phase 4: morning digest ─────────────────────────────
# Telegram: create a bot with @BotFather, send it any message, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates  ("chat":{"id": ...})
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Your Vercel URL — linked at the bottom of the digest
WEB_APP_URL=
# Optional email digest via Resend (free tier): https://resend.com/api-keys
# RESEND_API_KEY=
# NOTIFY_EMAIL_TO=you@example.com
